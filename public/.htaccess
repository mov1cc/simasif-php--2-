Options -MultiViews -Indexes
RewriteEngine On

RewriteRule ^$ HalamanPelanggan.html [R=302,L]
RewriteRule ^api/ api/index.php [L]
RewriteRule ^gate\.php$ - [L]

# Aset statis + halaman publik
RewriteRule ^(js|css|uploads)/ - [L]
RewriteRule ^(Login|LupaPassword|HalamanPelanggan)\.html$ - [L,NC]

# Semua .html lain (huruf besar/kecil apa pun) -> gate
RewriteRule \.html?$ gate.php [L,NC]