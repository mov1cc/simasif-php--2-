Options -MultiViews -Indexes
RewriteEngine On

RewriteRule ^$ Dashboard.html [R=302,L]
RewriteRule ^api/ api/index.php [L]
RewriteRule ^gate\.php$ - [L]

# Aset statis + halaman publik
RewriteRule ^(js|uploads)/ - [L]
RewriteRule ^(Login|LupaPassword)\.html$ - [L,NC]

# Semua .html lain (huruf besar/kecil apa pun) -> gate
RewriteRule \.html?$ gate.php [L,NC]